# ═══════════════════════════════════════════════════════════════
# HI Grade — .gitignore
# ═══════════════════════════════════════════════════════════════

# ─── SECRETS (NEVER COMMIT) ────────────────────────────────────
# API keys, tokens, credentials
*_key.txt
*_secret.txt
.env
.env.local
.env.*.local
api_keys.py
secrets/
credentials/
.secrets
*.pem
*.key
*.p12

# ─── PYTHON ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.env/
env.bak/
venv.bak/

# ─── NODE / EXTENSION ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
package-lock.json.bak

# Build outputs
dist/
build/
*.zip
human-edge*.zip
human-edge/dist/

# ─── iOS / XCODE ───────────────────────────────────────────────
# (only if the iOS source lives in this repo — adjust if external)
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# ─── EDITOR / IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.claude/

# ─── TEMPORARY / BACKUP FILES ──────────────────────────────────
*.bak
*.pre_*.bak
*.tmp
*.orig
.backup/
*.log

# Patcher scripts (one-off tools, shouldn't ship)
add_*.py
fix_*.py
patch_*.py
kill_*.py
dedup_*.py
refine_*.py
v12_*.py
swap_*.py
update_*.py
collect_*.py.bak
check_*.py

# ─── PIPELINE OUTPUTS (mostly-tracked — adjust as needed) ─────
# Large volatile data files
pipeline/data/prices/*.json
pipeline/data/validation/*.json
pipeline/data/history/*.json

# But DO commit the current state
!pipeline/data/scores/all_scores.json
!pipeline/data/subsignals/
!pipeline/data/human100/
!pipeline/data/heartbeat/
!pipeline/data/gov/

# Cache directories
.cache/
cache/
pipeline/.cache/

# ─── LOCAL DEVELOPMENT ─────────────────────────────────────────
local_config.py
local_settings.py
.local/
debug/
scratch/
playground/
tmp/
TODO.local.md
notes.local.md

# Jupyter
.ipynb_checkpoints/
*.ipynb.bak

# ─── ANALYTICS / TRACKING ──────────────────────────────────────
# Never commit analytics credentials or dumps
analytics_export.*
ga_*.csv
mixpanel_*.json

# ─── OS GARBAGE ────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS Finder duplicate files (case-insensitive filesystem artifacts)
* 2.json
* 3.json
*.bak
*.tmp
*.v120tmp.js

# Patcher backups (created by surgical patchers)
*.pre_*
