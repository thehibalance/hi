{
  "manifest_version": 3,
  "name": "HI. \u2014 Human Intelligence Grade",
  "version": "1.1.1",
  "description": "See every company's HI Grade as you browse. Human vs AI balance. Zero AI. Zero tracking. Open source.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.thehibalance.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/db.js",
        "lib/engine.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "32": "icons/icon-32.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "HI. \u2014 Human Intelligence Grade"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
