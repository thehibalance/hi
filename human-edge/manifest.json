{
  "manifest_version": 3,
  "name": "HI. — Human Intelligence Grade",
  "version": "1.0.0",
  "description": "See every company's HI Grade™ as you browse. Measures the balance between Human Intelligence and Artificial Intelligence. Zero AI. Zero tracking.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.thehibalance.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/db.js", "lib/engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "HI. — Human Intelligence Grade"
  }
}
